# Copy to .env and fill in the key(s) for the provider(s) you use.

# OpenRouter (default, --provider openrouter): https://openrouter.ai/keys  - ~50 free requests/day
OPENROUTER_API_KEY=...

# Groq (--provider groq): https://console.groq.com/keys  - ~1,000 free requests/day per model
GROQ_API_KEY=...

# Optional: make Groq the default provider instead of passing --provider groq each time
# LLM_PROVIDER=groq

# Any other OpenAI-compatible endpoint, e.g. KiloAI or a local Ollama (--provider custom)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_KEY=...
